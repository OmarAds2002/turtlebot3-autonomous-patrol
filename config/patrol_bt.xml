<!--
  Patrol behavior tree — mission-level executor
  Runs in patrol_commander (NOT in bt_navigator)

  Architecture per room:
    Fallback
    ├── ReactiveSequence             navigate unless object interrupts
    │   ├── Inverter(DetectObject)   SUCCESS = clear, FAILURE = object found
    │   └── NavigateToRoom           halted via onHalted() when Inverter fails
    ├── ApproachObject               runs when object interrupted nav
    └── Sequence                     nav failed, no object -> recover
        ├── RecoveryRotate           360 spin to re-localize
        └── WaitAndRetry             2s wait, returns FAILURE to trigger retry

  Top-level: CheckBattery gates the patrol loop.
  If battery < 20%, ChargeBattery fires (stub for demo).
-->

<root BTCPP_format="4">
  <BehaviorTree ID="PatrolTree">
    <Fallback>
      <ReactiveSequence>
        <CheckBattery/>
        <Sequence name="Patrol">

          <!-- Room 1 (top-left): map frame (1.0, 0.5) -->
          <Fallback>
            <ReactiveSequence>
              <Inverter>
                <DetectObject target="box" object_pose="{object_pose}"/>
              </Inverter>
              <NavigateToRoom x="1.0" y="0.5"/>
            </ReactiveSequence>
            <ApproachObject target_pose="{object_pose}"/>
            <Sequence>
              <RecoveryRotate/>
              <WaitAndRetry/>
            </Sequence>
          </Fallback>

          <!-- Room 2 (top-right): map frame (5.0, 0.5) -->
          <Fallback>
            <ReactiveSequence>
              <Inverter>
                <DetectObject target="box" object_pose="{object_pose}"/>
              </Inverter>
              <NavigateToRoom x="5.0" y="0.5"/>
            </ReactiveSequence>
            <ApproachObject target_pose="{object_pose}"/>
            <Sequence>
              <RecoveryRotate/>
              <WaitAndRetry/>
            </Sequence>
          </Fallback>

          <!-- Room 3 (bottom-right): map frame (5.0, -3.5) -->
          <Fallback>
            <ReactiveSequence>
              <Inverter>
                <DetectObject target="box" object_pose="{object_pose}"/>
              </Inverter>
              <NavigateToRoom x="5.0" y="-3.5"/>
            </ReactiveSequence>
            <ApproachObject target_pose="{object_pose}"/>
            <Sequence>
              <RecoveryRotate/>
              <WaitAndRetry/>
            </Sequence>
          </Fallback>

          <!-- Room 4 (bottom-left): map frame (1.0, -3.5) -->
          <Fallback>
            <ReactiveSequence>
              <Inverter>
                <DetectObject target="box" object_pose="{object_pose}"/>
              </Inverter>
              <NavigateToRoom x="1.0" y="-3.5"/>
            </ReactiveSequence>
            <ApproachObject target_pose="{object_pose}"/>
            <Sequence>
              <RecoveryRotate/>
              <WaitAndRetry/>
            </Sequence>
          </Fallback>

        </Sequence>
      </ReactiveSequence>
      <!-- battery too low — dock and charge (stub: logs and returns SUCCESS) -->
      <ChargeBattery/>
    </Fallback>
  </BehaviorTree>

  <TreeNodesModel>
    <Condition ID="CheckBattery"/>
    <Condition ID="DetectObject">
      <input_port name="target"/>
      <output_port name="object_pose"/>
    </Condition>
    <Action ID="ApproachObject">
      <input_port name="target_pose"/>
    </Action>
    <Action ID="NavigateToRoom">
      <input_port name="x"/>
      <input_port name="y"/>
    </Action>
    <Action ID="RecoveryRotate"/>
    <Action ID="WaitAndRetry"/>
    <Action ID="ChargeBattery"/>
  </TreeNodesModel>
</root>